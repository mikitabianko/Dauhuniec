{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dauhuniec build presets",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "default_preset": {
      "type": "string",
      "default": "debug"
    },
    "presets": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extends": {
            "type": "string"
          },
          "debug": {
            "type": "boolean"
          },
          "optimization": {
            "enum": [
              "-O0",
              "-O1",
              "-O2",
              "-O3",
              "-Og",
              "-Os",
              "-Oz",
              "-Ofast"
            ]
          },
          "build_flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Flags appended to C and C++ compiler flags. Values use Make recipe quoting."
          },
          "c_flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional C compiler flags."
          },
          "cxx_flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional C++ compiler flags."
          },
          "asm_flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional assembler flags."
          },
          "link_flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional linker flags."
          }
        }
      }
    }
  }
}
